dhcp_prefix  = "_DHCP_SUBNET_PREFIX_"

# this is almost the standard for HPOC multi node for secondary network
# The last octet of the IP to DELETE from the DHCP pool ($PREFIX.$IP0)
dhcp_ip0 = "134"

# The last octets for the FIRST new DHCP pool range ($PREFIX.$START_IP1 to $PREFIX.$END_IP1)
dhcp_start_ip1 = "134"
dhcp_end_ip1   = "149"

# The last octets for the SECOND new DHCP pool range ($PREFIX.$START_IP2 to $PREFIX.$END_IP2)
dhcp_start_ip2 = "180"
dhcp_end_ip2   = "253"

