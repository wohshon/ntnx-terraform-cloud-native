set -e

echo "Installing Ansible and WinRM dependencies..."
sudo apt-get update > /dev/null 2>&1
sudo apt-get install -y ansible python3-winrm > /dev/null 2>&1

echo "Installing microsoft.ad collection..."
ansible-galaxy collection install ansible.windows microsoft.ad > /dev/null 2>&1

echo "Generating Ansible Inventory..."
cat << 'INVENTORY' > ${bastion_working_dir}/ad_inventory.ini
[domain_controllers]
${ad_ip}

[domain_controllers:vars]
ansible_user=${ad_user}
ansible_password=${ad_password}
ansible_connection=winrm
ansible_port=5985
ansible_winrm_scheme=http
ansible_winrm_server_cert_validation=ignore
ansible_winrm_transport=ntlm
INVENTORY

echo "Generating dynamic vars file from Terraform map..."
cat << VARS_YML > ${bastion_working_dir}/ad_vars.yml
ad_groups:
%{for group_name, config in nkp_ad_groups~}
  "${group_name}":
%{for m in concat(config.users, config.groups)~}
- "
${m}"
%{endfor~}
%{endfor~}
VARS_YML

echo "Generating Ansible Playbook..."
cat << 'PLAYBOOK' > ${bastion_working_dir}/ad_config.yml
---
- name: Configure AD Users and Groups
  hosts: domain_controllers
  gather_facts: no
  vars_files:
- ad_vars.yml
  tasks:
- name: Create nkp-svc user and add to Administrators
      microsoft.ad.user:
        name: nkp-svc
        password: "Passw0rd1234_"
        state: present
        groups:
          add:
- Administrators
        password_never_expires: yes
        user_cannot_change_password: yes

- name: Create AD groups dynamically
      microsoft.ad.group:
        name: "{{ item.key }}"
        scope: global
        state: present
      loop: "{{ ad_groups | dict2items }}"

- name: Add members to AD groups dynamically
      microsoft.ad.group:
        name: "{{ item.key }}"
        members:
          add: "{{ item.value }}"
      loop: "{{ ad_groups | dict2items }}"
      when: item.value | length > 0
PLAYBOOK

echo "Running Ansible Playbook from Bastion to configure Active Directory..."
ansible-playbook -i ${bastion_working_dir}/ad_inventory.ini ${bastion_working_dir}/ad_config.yml

echo "Active Directory configuration complete!"