# Edit this file to set the environment variables for the automation scripts
# PC PE related
export PROJECT_NAME="lab"
export PE_CLUSTER_NAME="RNO-SPOC015-2"
export PRIMARY_SUBNET_PREFIX="10.8.95"
# run mgmt.sh?
export INSTALL_NKP_MGMT_CLUSTER=false
export DEPLOY_NAI=true
export DEPLOY_GITLAB=false
# this pairs with HOSTING_URL in setup sh to form the hosting path for the bundles
export NKP_HOSTING_PATH="users/wohshon/nkp_219"

# please ensure the keys / passwords are matched with the ones in .sensitive.env
export VM_USER="wohshon"

# these below are generally staic, unless you are changing versions erc 
export NUTANIX_USER=admin
export AD_USER="Administrator"
export CVM_USER="nutanix"

export NKP_VERSION_BUILD=2.19
export NAI_VERSION_BUILD=2.8
export NKP_VERSION_PATCH=0
export NAI_VERSION_PATCH=1
# this is not used
export PC_VERSION=7.6
# automation variables
# add in public key for bastion
# location of the private key for the bastion VM
# inject via .sensitive.env
export SSH_PRIVATE_BASTION_KEY="${SSH_PRIVATE_GENERIC_KEY}"
export SSH_PUBLIC_BASTION_KEY="${SSH_PUBLIC_GENERIC_KEY}"
export SSH_KEY_PRIVATE_BASTION_VM_FILE="id_ed25519"
export SSH_KEY_PUBLIC_BASTION_VM_FILE="id_ed25519.pub"
export SSH_KEY_PUBLIC_BASTION_VM_PATH="keys/bastion/ssh"
export SSH_KEY_PRIVATE_BASTION_VM_PATH="keys/bastion/ssh"
# add in public key for registry
export SSH_PRIVATE_REGISTRY_KEY="${SSH_PRIVATE_GENERIC_KEY}"
export SSH_PUBLIC_REGISTRY_KEY="${SSH_PUBLIC_GENERIC_KEY}"
export SSH_KEY_PRIVATE_REGISTRY_VM_FILE="id_ed25519"
export SSH_KEY_PRIVATE_REGISTRY_VM_PATH="keys/bastion/ssh"
export SSH_KEY_PUBLIC_REGISTRY_VM_FILE="id_ed25519.pub"
export SSH_KEY_PUBLIC_REGISTRY_VM_PATH="keys/bastion/ssh"

export TLS_KEY_PRIVATE_REGISTRY_VM_FILE="registry-private.key"
export TLS_KEY_PRIVATE_REGISTRY_VM_PATH="keys/registry/tls"
export TLS_KEY_PUBLIC_REGISTRY_VM_FILE="registry-server.crt"
export TLS_KEY_PUBLIC_REGISTRY_VM_PATH="keys/registry/tls"

# add in public key for gitlab
export SSH_PRIVATE_GITLAB_KEY="${SSH_PRIVATE_GENERIC_KEY}"
export SSH_PUBLIC_GITLAB_KEY="${SSH_PUBLIC_GENERIC_KEY}"
export SSH_KEY_PRIVATE_GITLAB_VM_FILE="id_ed25519"
export SSH_KEY_PRIVATE_GITLAB_VM_PATH="keys/bastion/ssh"
export SSH_KEY_PUBLIC_GITLAB_VM_FILE="id_ed25519.pub"
export SSH_KEY_PUBLIC_GITLAB_VM_PATH="keys/bastion/ssh"

export TLS_KEY_PRIVATE_GITLAB_VM_FILE="gitlab.ntnxlab.local.key"
export TLS_KEY_PRIVATE_GITLAB_VM_PATH="keys/gitlab/tls"
export TLS_KEY_PUBLIC_GITLAB_VM_FILE="gitlab.ntnxlab.local.crt"
export TLS_KEY_PUBLIC_GITLAB_VM_PATH="keys/gitlab/tls"

# NKP Installation on bastion related
export NKP_INSTALLATION_GIT_REPO_BRANCH="v2_2.19.0-nai_2.8.1-private-repo-pc76"
export NKP_INSTALLATION_GIT_REPO_URL="git@github.com:wohshon/nkp-installation-scripts.git"
export NKP_INSTALLATION_GIT_REPO_DIR="nkp-installation-scripts"
export NKP_BASTION_WORKING_DIR="/home/${VM_USER}"
export NKP_BASTION_BUNDLE_NAME="nkp-bundle_v2.19.0_linux_amd64.tar.gz"
export NKP_BASTION_BUNDLE_EXTRACTION_DIR="extracted"

export OS_DOWNLOAD_PATH="users/wohshon/os"

export SELF_SERVICE_STORAGE_CONTAINER_NAME="SelfServiceContainer"
