# provide these in a .sensitive.env file this current directory
export NUTANIX_PASSWORD='xxxxxx'
export VM_USER_PASSWORD='xxxxxx'
export AD_BIND_PASSWORD="xxxxxx"
export SLACK_WEBHOOK_URL="https://hooks.slack.com/triggers/xxxxx"

# Linux SHA-512 crypt hash.
# openssl passwd -6 "YourNewPasswordHere"  
export VM_USER_PWD_HASH='sfsdfasdfds'

# Userdata.yaml
export DOCKER_USER="username"
export DOCKERIO_TOKEN="dckr_pat_xxxxxx"
export DOCKERIO_URL="https://index.docker.io/v1/"
export PRIVATE_REGISTRY_USER="username"
export PRIVATE_REGISTRY_TOKEN="xxxxxx"
export PRIVATE_REGISTRY_URL="https://registry.xxxxx"
export PACKER_USER_DATA_ROOT_PASSWD="xxxxxx"
# these keys get injected into all your custom VMs
# if you need dedicated key pairs per VM, refer to environment.env to see how they can be injected
export SSH_PUBLIC_GENERIC_KEY='ssh-ed25519 xxxxxxx a@b.com'
export SSH_PRIVATE_GENERIC_KEY='-----BEGIN OPENSSH PRIVATE KEY-----
xxxxxxxxxx
-----END OPENSSH PRIVATE KEY-----'
export PHX_HOSTING_URL="http://xxxxx"
export DM3_HOSTING_URL="http://yyyyy"